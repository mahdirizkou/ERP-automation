    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nreturn items.map(item => {\n  return {\n    json: {\n      distributor: typeof item.json[\"Distributor\"] === \"string\"\n        ? item.json[\"Distributor\"].trim()\n        : \"\",\n\n      customer: typeof item.json[\"Customer Name\"] === \"string\"\n        ? item.json[\"Customer Name\"].trim()\n        : \"\",\n\n      city: item.json[\"City\"] ?? \"\",\n      country: item.json[\"Country\"] ?? \"\",\n\n      product: typeof item.json[\"Product Name\"] === \"string\"\n        ? item.json[\"Product Name\"].trim()\n        : \"\",\n\n      productClass: item.json[\"Product Class\"] ?? \"\",\n\n      quantity: Number(item.json[\"Quantity\"]) || 0,\n      price: Number(item.json[\"Price\"]) || 0,\n      sales: Number(item.json[\"Sales\"]) || 0,\n\n      month: item.json[\"Month\"] ?? \"\",\n      year: Number(item.json[\"Year\"]) || 0,\n\n      salesRep: item.json[\"Name of Sales Rep\"] ?? \"\",\n      manager: item.json[\"Manager\"] ?? \"\",\n      team: item.json[\"Sales Team\"] ?? \"\",\n\n      isValid: (\n        Number(item.json[\"Quantity\"]) > 0 &&\n        Number(item.json[\"Price\"]) > 0\n      )\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
