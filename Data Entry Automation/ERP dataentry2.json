    {
      "parameters": {
        "jsCode": "const allItems = $('Cleaning + Validation').all();\n\nconst totalRows     = allItems.length;\nconst validRows     = allItems.filter(i => i.json._isValid).length;\nconst invalidRows   = totalRows - validRows;\nconst duplicateRows = allItems.filter(i => i.json._isDuplicate).length;\nconst successRate   = totalRows > 0\n  ? ((validRows / totalRows) * 100).toFixed(2) + '%'\n  : '0%';\n\nconst spreadsheetId = $('Store Sheet ID').first().json.spreadsheetId;\n\nreturn [{\n  json: {\n    totalRows,\n    validRows,\n    invalidRows,\n    duplicateRows,\n    successRate,\n    generatedAt: new Date().toISOString(),\n    spreadsheetUrl: `https://docs.google.com/spreadsheets/d/${spreadsheetId}/edit#gid=0`,\n    errorLogUrl:    `https://docs.google.com/spreadsheets/d/${spreadsheetId}/edit#gid=1`\n  }\n}];"
      },
