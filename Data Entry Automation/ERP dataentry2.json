    {
      "parameters": {
        "jsCode": "const seen = new Set();\n\nreturn items.map(item => {\n  const raw = item.json;\n\n  const quantity = Number(raw['Quantity']) || 0;\n  const price    = Number(raw['Price'])    || 0;\n  const sales    = Number(raw['Sales'])    || 0;\n\n  const errors = [];\n\n  const customerName = (raw['Customer Name'] || '').trim();\n  const productName  = (raw['Product Name']  || '').trim();\n  const month        = (raw['Month']         || '').toString().trim();\n  const year         = (raw['Year']          || '').toString().trim();\n\n  if (!customerName)\n    errors.push('Missing Customer Name');\n\n  if (!productName)\n    errors.push('Missing Product Name');\n\n  if (quantity <= 0)\n    errors.push('Invalid Quantity');\n\n  if (price <= 0)\n    errors.push('Invalid Price');\n\n  if (Math.abs(sales - quantity * price) > 0.01)\n    errors.push('Sales mismatch (expected: ' + (quantity * price).toFixed(2) + ')');\n\n  const duplicateKey = [\n    customerName.toLowerCase(),\n    productName.toLowerCase(),\n    month.toLowerCase(),\n    year.toLowerCase()\n  ].join('|');\n\n  let isDuplicate = false;\n  if (seen.has(duplicateKey)) {\n    isDuplicate = true;\n    errors.push('Duplicate Record');\n  } else {\n    seen.add(duplicateKey);\n  }\n\n  return {\n    json: {\n      'Customer Name': customerName,\n      'Product Name':  productName,\n      Month:           month,\n      Year:            year,\n      Quantity:        quantity,\n      Price:           price,\n      Sales:           sales,\n      _isDuplicate:    isDuplicate,\n      _isValid:        errors.length === 0,\n      _errorReason:    errors.join(', ')\n    }\n  };\n});"
      },
      "id": "clean-validate",
      "name": "Cleaning + Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
